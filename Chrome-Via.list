# ---------------- 五、IP 规则: 局域网直连, 海外 IP 走代理 ----------------
# 局域网 / 内网地址一律直连, no-resolve 表示不先解析域名、直接按 IP 匹配
ip-cidr, 192.168.0.0/16, direct, no-resolve
ip-cidr, 10.0.0.0/8, direct, no-resolve
ip-cidr, 172.16.0.0/12, direct, no-resolve
ip-cidr, 127.0.0.0/8, direct, no-resolve
ip-cidr, 100.64.0.0/10, direct, no-resolve
ip-cidr, 224.0.0.0/4, direct, no-resolve
ip-cidr, 240.0.0.0/4, direct, no-resolve

# 中国 IP 直连 (GEOIP 需 QX 内置 IP 库支持)
geoip, CN, direct

# Google / Cloudflare 等海外服务商 IP 段兜底, 域名规则漏了就靠 IP 兜
ip-asn, 15169, proxy
ip-asn, 13335, proxy
ip-asn, 16509, proxy
ip-asn, 8075, proxy
ip-asn, 32934, proxy
ip-cidr, 8.8.8.8/32, proxy, no-resolve
ip-cidr, 8.8.4.4/32, proxy, no-resolve
ip-cidr, 1.1.1.1/32, proxy, no-resolve
ip-cidr, 1.0.0.1/32, proxy, no-resolve

# ---------------- 六、兜底 ----------------
# 上面都没命中的: 国内 IP 已在第五节直连, 剩下的默认走代理,
# 这样 Chrome / Via 里打开没列出来的海外站也能打开
# 如果你只想让上面列出来的站走代理、其他全部直连,
# 把下面这行改成 final, direct
final, proxy
